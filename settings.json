// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "proxy": "",
  "agent": {
    "notify_when_agent_waiting": "all_screens",
    "thinking_display": "always_collapsed",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "mcp:mcp-server-godot:get_project_info": {
          "default": "allow"
        },
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^M-Vave-Chocolate-Plus/open-chocolate/src/lib/"
            },
            {
              "pattern": "^M-Vave-Chocolate-Plus/reverse-engineering/"
            }
          ],
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^M-Vave-Chocolate-Plus/open-chocolate/src/lib/"
            },
            {
              "pattern": "^/home/maja/Projects/majabojarska/M-Vave-Chocolate-Plus/reverse-engineering/"
            },
            {
              "pattern": "^/home/maja/Projects/majabojarska/M-Vave-Chocolate-Plus/open-chocolate/src/"
            },
            {
              "pattern": "^M-Vave-Chocolate-Plus/open-chocolate/native/"
            }
          ],
        },
        "write_file": {
          "always_allow": [
            {
              "pattern": "/home/majabojarska/Projects/M-Vave-Chocolate-Plus",
            },
          ],
        },
        "terminal": {
          "default": "allow",
          "always_allow": [],
        },
      },
    },
    "flexible": true,
    "dock": "right",
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "allow_unsandboxed": true,
      "network_hosts": ["github.com"],
      "write_paths": [
        "/home/maja/Projects/majabojarska/M-Vave-Chocolate-Plus",
        "/home/maja/Projects/majabojarska/infra",
      ],
    },
    "default_model": {
      "provider": "openrouter",
      "model": "meta/muse-spark-1.3-contributor",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": [],
  },
  "languages": {
    "Nix": {
      "show_edit_predictions": true,
    },
  },
  "show_edit_predictions": false,
  "cli_default_open_behavior": "existing_window",
  "mouse_wheel_zoom": true,
  "diff_view_style": "unified",
  "auto_signature_help": true,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "status_bar": {
    "show_active_file": true,
  },
  "git_panel": {
    "diff_stats": true,
    "file_icons": true,
    "tree_view": true,
    "dock": "right",
  },
  "show_whitespaces": "selection",
  "agent_servers": {
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "allow_all": ["on"],
      },
      "default_config_options": {
        "reasoning_effort": "low",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "off",
        "model": "gpt-5.6-luna",
      },
      "type": "registry",
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "model": ["haiku"],
      },
      "default_config_options": {
        "effort": "default",
        "mode": "plan",
        "model": "opus[1m]",
      },
      "type": "registry",
    },
  },
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": true,
  "buffer_font_family": "Hack",
  "buffer_font_size": 14.0,
  "buffer_font_features": {},
  "buffer_font_weight": 300,
  "buffer_line_height": { "custom": 1.4 },
  "current_line_highlight": "none",
  "cursor_shape": "bar",
  "format_on_save": "off",
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "project_panel": { "dock": "left" },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 16,
  "vim_mode": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "use_smartcase_search": true,
  "expand_excerpt_lines": 16,
  "excerpt_context_lines": 16,
  "relative_line_numbers": "enabled",
  "file_scan_exclusions": [
    // Defaults
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // Extras
    "*.pb.go",
  ],
